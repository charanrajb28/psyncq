{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "@vercel/node"]
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "scripts/**/*.ts"]
}
